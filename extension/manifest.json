{
  "manifest_version": 3,
  "name": "VK — Фото на весь экран",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "description": "Фото VK на весь экран: локальное ИИ-увеличение, автокоррекция, масштаб и стрелки альбома.",
  "permissions": ["offscreen"],
  "host_permissions": [
    "https://*.userapi.com/*", "https://*.vkuserphoto.ru/*", "https://*.vkuserphoto.com/*",
    "https://*.vk-cdn.net/*", "https://*.vkuser.net/*", "https://*.vk.ru/*", "https://*.vk.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://vk.ru/*", "https://*.vk.ru/*", "https://vk.com/*", "https://*.vk.com/*"],
    "js": ["geometry.js", "appearance.js", "viewer.js"],
    "run_at": "document_idle"
  }]
}
